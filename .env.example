# WeCom Callback Service Configuration
# Copy this file to .env and fill in the values

# Enterprise WeChat (WeCom) Credentials
WECOM_CORP_ID=your_enterprise_corp_id
WECOM_AGENT_ID=your_agent_id
WECOM_SECRET=your_app_secret
WECOM_TOKEN=your_callback_token
WECOM_ENCODING_AES_KEY=your_43_char_encoding_aes_key_here_xxxxx

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
XAI_API_KEY=xai-your-grok-key

# 3 Bot Webhook URLs (get from WeCom group settings)
WEBHOOK_GPT=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WEBHOOK_GEMINI=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WEBHOOK_GROK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# Chat Storage Configuration
CHAT_DB_PATH=chat_storage.db

# GitLab Configuration (for internal network deployment)
GITLAB_URL=http://gitlab.yourcompany.com
GITLAB_PRIVATE_TOKEN=your_gitlab_private_access_token

